# Copy to backend/.env and fill in your own values. Never commit real secrets.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TAVILY_API_KEY=

# Must match infra/postgres/.env for a local Docker database.
MEMORY_DB_HOST=127.0.0.1
MEMORY_DB_PORT=5432
MEMORY_DB_NAME=rag_memory
MEMORY_DB_USER=rag_user
MEMORY_DB_PASSWORD=

